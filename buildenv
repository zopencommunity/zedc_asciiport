zopen_check_results()
{
  dir="$1"
  pfx="$2"
  chk="$1/$2_check.log"
  totalTests=$(grep -i "^Total tests:" $chk | awk '{ print $3}') 
  failures=$(grep -i "^Failed:" $chk | awk '{ print $2}')
  
# Echo the following information to guage build health
cat <<TEST
actualFailures:$failures
totalTests:$totalTests
expectedFailures:0
TEST
}

zopen_append_to_env()
{
cat <<ZZ
if [ -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
    return 0; # Do nothing
fi

if [ -r "@ZEDC_LIB_PATH@" ] ; then
     echo "libzz.a found at \$ZEDC_LIB_PATH"
     export ZOPEN_EXTRA_CFLAGS="\${ZOPEN_EXTRA_CFLAGS} -I\$PWD/include"
     export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS} -I\$PWD/include"
     export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\$PWD/lib -L@ZEDC_LIB_PATH@"
     export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} -lz -lzz"
else
    echo "Unable to find libzz.a" >&2
    return 1
fi

return 0

ZZ
}

zopen_append_to_setup()
{
cat <<ZZ

zzfound=false
ZEDC_LIB_PATH=

if [ -r "/usr/lpp/hzc/lib/libzz.a" ]; then
     ZEDC_LIB_PATH="/usr/lpp/hzc/lib/"
     zzfound=true
else
     OLD_IFS=\$IFS
     IFS=':'
     for p in \${LIBPATH}; do
       if [ -r "\$p/libzz.a" ]; then
         ZEDC_LIB_PATH=\$p
         zzfound=true
         break
       fi
     done
     IFS=\$OLD_IFS
fi

if \${zzfound} ; then
     echo "libzz.a found at \$ZEDC_LIB_PATH"
     APPENV_FILE="\${ZOPEN_INSTALL_DIR}/.appenv"
     PC_FILE="\${ZOPEN_INSTALL_DIR}/lib/pkgconfig/zlib.pc"
     if [ -w "\$APPENV_FILE" ]; then
         sed -i "s|@ZEDC_LIB_PATH@|\${ZEDC_LIB_PATH}|" "\$APPENV_FILE"
     fi
     if [ -w "\$PC_FILE" ]; then
         sed -i "s|@ZEDC_LIB_PATH@|\${ZEDC_LIB_PATH}|" "\$PC_FILE"
     fi
else
    echo "Warning: Unable to find libzz.a. zlib.pc may contain incorrect paths." >&2
fi
ZZ
}

